# Every `changeme` must match the credentials set in storage/config and
# monitor/config (URL-encode special characters inside connection URLs).
DATABASE_URL=postgresql://admin:changeme@postgres:5432/langfuse
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=changeme
REDIS_CONNECTION_STRING=redis://:changeme@redis:6379
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=admin
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=changeme
NEXTAUTH_URL=http://localhost:3031

# --- required by Langfuse v3 self-host ---
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000
# Generate both values with: openssl rand -hex 32
SALT=<openssl rand -hex 32>
ENCRYPTION_KEY=<openssl rand -hex 32>
LANGFUSE_S3_EVENT_UPLOAD_REGION=auto
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
CLICKHOUSE_CLUSTER_ENABLED=false
