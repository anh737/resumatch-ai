# Read by docker-compose.yml to build the in-network connection URLs injected
# into the app containers. Must match the credentials the storage stack was
# initialized with (storage/config/*/.env, storage/config/redis/redis.conf).
INFRA_USER=admin
# URL-encoded form of the password (e.g. p@ss -> p%40ss)
INFRA_PASSWORD_URLENC=changeme
# Raw (non-encoded) form — used for MinIO credentials.
INFRA_PASSWORD=changeme

# Browser-facing URLs baked into the two UIs at build time (cross links in
# their sidebars). Only change them when the stacks are exposed elsewhere.
ADMIN_PORTAL_URL=http://localhost:3001
CHAT_URL=http://localhost:3000
# Browser-facing origin of the Langfuse proxy embedded by the admin portal.
# Leave empty to derive it in the browser as <portal host>:3002.
LANGFUSE_EMBED_URL=
