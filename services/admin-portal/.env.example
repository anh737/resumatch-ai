# Base URL the browser calls for the admin API. Keep "/api" so the Vite dev
# server (and nginx in Docker) proxy it to bot-agent; set an absolute URL only
# if bot-agent is exposed directly and has CORS enabled.
VITE_API_BASE_URL=/api

# Where the Vite dev server forwards /api/* (dev only): bot-agent.
VITE_PROXY_TARGET=http://localhost:8001

# Link back to the chat UI shown in the sidebar (leave empty to hide it).
VITE_CHAT_URL=http://localhost:3000

# Browser-facing origin of the Langfuse proxy that the "Langfuse dashboard" page
# embeds (nginx listener :8080 of the Docker image, published on :3002). Leave
# empty to derive it at runtime as <portal host>:3002. In `npm run dev` the proxy
# does not exist, so either run `docker compose up -d admin-portal` alongside or
# point this at any origin that allows framing.
VITE_LANGFUSE_EMBED_URL=
