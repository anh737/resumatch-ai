# WebSocket upgrade passthrough (used by the Langfuse proxy below).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ------------------------------------------------------------------------------
# Admin portal (container :80, host :3001): the React bundle + /api -> bot-agent
# ------------------------------------------------------------------------------
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Container DNS (NGINX_LOCAL_RESOLVERS is filled from /etc/resolv.conf by the
    # official image's entrypoint). Re-resolve every 10s so the upstream may
    # start, restart or move after nginx has booted.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    # Single-page app: unknown paths fall back to index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Admin API -> bot-agent. `/api/admin/uploads` becomes `/admin/uploads` upstream.
    # proxy_pass with a variable makes nginx resolve the host at request time
    # instead of at startup, so the portal still boots when bot-agent is down.
    location /api/ {
        set $api_upstream ${API_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        # CV/JD uploads go through here; keep in sync with bot-agent's
        # UPLOAD_MAX_MB (20 MB) — nginx's default cap is only 1 MB.
        client_max_body_size 25m;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        error_page 502 503 504 = @api_unavailable;
    }

    # Backend down / not deployed: answer with JSON the UI can display.
    location @api_unavailable {
        default_type application/json;
        return 503 '{"detail":"The admin API (bot-agent) is not reachable. Start it and try again."}';
    }

    # Hashed build assets are safe to cache for a long time.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}

# ------------------------------------------------------------------------------
# Langfuse dashboard proxy (container :8080, host :3002) — embedded in the portal
#
# Langfuse answers with `X-Frame-Options: SAMEORIGIN` and a CSP containing
# `frame-ancestors 'none'`, so a browser refuses to render http://localhost:3031
# inside the portal. This listener serves the same Langfuse instance at the root
# of its own port (Next.js emits absolute /_next, /api, /project paths, so a
# sub-path such as /langfuse/ is not an option without rebuilding Langfuse),
# drops those two headers and allows only the portal origin(s) to frame it.
# Cookies are host-scoped (not port-scoped), so a session signed in on :3031
# is valid on :3002 as well.
# ------------------------------------------------------------------------------
server {
    listen 8080;
    server_name _;
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    location / {
        set $lf_upstream ${LANGFUSE_UPSTREAM};
        proxy_pass $lf_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # NextAuth / Next.js redirect to their configured public URL (NEXTAUTH_URL)
        # or to the upstream host; keep such redirects inside this origin.
        proxy_redirect ${LANGFUSE_PUBLIC_URL}/ /;
        proxy_redirect ${LANGFUSE_UPSTREAM}/ /;

        # Allow embedding by the portal only.
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Content-Security-Policy;
        add_header Content-Security-Policy "frame-ancestors ${LANGFUSE_FRAME_ANCESTORS}" always;

        # Langfuse sets large headers (its CSP alone is ~2 KB, plus cookies).
        proxy_buffer_size 32k;
        proxy_buffers 8 32k;
        proxy_busy_buffers_size 64k;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        error_page 502 503 504 = @langfuse_unavailable;
    }

    location @langfuse_unavailable {
        default_type text/html;
        return 503 '<!doctype html><html><body style="font-family:system-ui;padding:32px;color:#444"><h2>Langfuse is not reachable</h2><p>The portal proxies <code>langfuse-web:3000</code> here. Start the monitor stack (<code>cd monitor &amp;&amp; docker compose up -d</code>) and reload.</p></body></html>';
    }
}
