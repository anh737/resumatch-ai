# Base URL the browser calls for the chat API. Keep "/api" so the Vite dev
# server (and nginx in Docker) proxy it to the backends; set an absolute URL
# only if the APIs are exposed directly and have CORS enabled.
VITE_API_BASE_URL=/api

# Where the Vite dev server forwards /api/* (dev only): bot-agent for the chat
# API, ai-agents for the /api/ws/* WebSocket answer stream.
VITE_PROXY_TARGET=http://localhost:8001
VITE_WS_PROXY_TARGET=http://localhost:8000

# Admin portal (services/admin-portal) linked from the sidebar; leave empty to hide the link.
VITE_ADMIN_PORTAL_URL=http://localhost:3001
