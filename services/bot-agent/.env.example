APP_NAME=bot-agent
APP_HOST=0.0.0.0
APP_PORT=8001
DEBUG=true

CHAT_HISTORY_TURNS=10

POSTGRES_URL=postgresql://admin:changeme@localhost:5432/postgres
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_CLIENT_ID=bot-agent
KAFKA_CONSUMER_GROUP=bot-agent
KAFKA_TOPIC_PREFIX=resume-scan

# Admin uploads (host addresses; docker-compose overrides with in-network ones)
MINIO_ENDPOINT=localhost:9010
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=changeme
MINIO_SECURE=false
MINIO_RESUME_BUCKET=resumes
MINIO_JOB_BUCKET=jobs
UPLOAD_MAX_MB=20

# Langfuse (create keys in the Langfuse UI at http://localhost:3031)
LANGFUSE_HOST=http://localhost:3031
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_URL=http://localhost:3031
