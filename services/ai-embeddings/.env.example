# App
APP_NAME=ai-embeddings
APP_HOST=0.0.0.0
APP_PORT=8002
DEBUG=true

# OpenAI
OPENAI_API_KEY=REPLACE_ME
OPENAI_STRUCTURE_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Storage stack (host addresses; docker-compose overrides with in-network ones)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_CV_COLLECTION=cv_information_technology
QDRANT_JD_COLLECTION=jd_jobs
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_CONSUMER_GROUP=ai-embeddings
KAFKA_TOPIC_PREFIX=resume-scan
MINIO_ENDPOINT=localhost:9010
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=changeme
MINIO_SECURE=false

# Langfuse (create keys in the Langfuse UI at http://localhost:3031)
LANGFUSE_HOST=http://localhost:3031
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENABLED=true
LANGFUSE_ENVIRONMENT=
